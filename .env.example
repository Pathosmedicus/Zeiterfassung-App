# Beispiel-Umgebungsvariablen für die Zeiterfassungs-App
# Kopiere diese Datei zu .env und trage deine echten Firebase-Zugangsdaten ein.

FIREBASE_API_KEY=dein_firebase_api_key_hier
FIREBASE_AUTH_DOMAIN=dein-projekt.firebaseapp.com
FIREBASE_PROJECT_ID=dein-projekt-id
FIREBASE_STORAGE_BUCKET=dein-projekt.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=deine_sender_id
FIREBASE_APP_ID=deine_app_id

# Vite Client-Variablen
VITE_FIREBASE_API_KEY=dein_firebase_api_key_hier
VITE_FIREBASE_AUTH_DOMAIN=dein-projekt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dein-projekt-id
VITE_FIREBASE_STORAGE_BUCKET=dein-projekt.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=deine_sender_id
VITE_FIREBASE_APP_ID=deine_app_id
